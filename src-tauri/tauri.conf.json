{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patina",
  "version": "0.1.0",
  "identifier": "com.distinctza.patina",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Patina",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "public.app-category.utilities",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Rick Wagner (Z8DX5X3H4R)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    }
  }
}

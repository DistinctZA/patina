class Patina < Formula
  desc "Dual-pane file manager for macOS"
  homepage "https://github.com/DistinctZA/patina"
  url "https://github.com/DistinctZA/patina/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256@"
  license "MIT"

  depends_on "node" => :build
  depends_on "rust" => :build
  depends_on macos: :ventura

  def install
    system "npm", "ci", "--include=dev", "--no-audit", "--no-fund"
    system "npm", "run", "build:app"
    prefix.install "src-tauri/target/release/bundle/macos/Patina.app"
    (bin/"patina").write <<~SH
      #!/bin/sh
      exec /usr/bin/open -a "#{opt_prefix}/Patina.app" "$@"
    SH
    (bin/"patina").chmod 0755
  end

  test do
    app = prefix/"Patina.app"
    assert_predicate bin/"patina", :executable?
    assert_predicate app/"Contents/MacOS/patina", :executable?
    info = app/"Contents/Info.plist"
    assert_equal version.to_s, shell_output("/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' '#{info}'").strip
    system "/usr/bin/codesign", "--verify", "--strict", app
  end
end
